{
	"name": "Cabrillo",
	"scopeName": "source.cabrillo",
	"fileTypes": [ "log", "cbr", "cab", "cabrillo" ],
	"patterns": [
		{
			"comment": "comment lines, X-QSO lines",
			"match": "^(?i)\\s*X-.*$",
			"name": "comment.line"
		},
		{
			"comment": "start and end of log tags",
			"match": "^(?i)\\s*(START-OF-LOG|END-OF-LOG):",
			"name": "entity.name.section"
		},
		{
			"comment": "Cabrillo header",
			"match": "^(?i)\\s*(CALLSIGN|CONTEST|CATEGORY-.*|CLAIMED-SCORE|CLUB|CREATED-BY|EMAIL|GRID-LOCATOR|LOCATION|OFFTIME|OPERATORS|SOAPBOX|NAME|ADDRESS|ADDRESS-.*|CERTIFICATE|DEBUG):(.*)$",
			"captures": {
				"1": { "name": "constant.language" },
				"2": { "name": "string.unquoted" }
			}
		},
		{
			"comment": "QSO line",
			"name": "meta.qso",
			"begin": "^(?i)\\s*(QSO|QTC):",
			"end": "$",
			"beginCaptures": {
				"1": { "name": "entity.name.function" }
			},
			"patterns": [
				{
					"comment": "Frequency and mode",
					"match": "\\b(\\d{3,5}|1\\.2G|2\\.3G|3\\.4G|5\\.7G|10G|24G|47G|75G|122G|134G|241G|LIGHT)\\s+(CW|PH|FM|RY|DG)\\b",
					"captures": {
						"1": { "name": "keyword.other" },
						"2": { "name": "entity.name.type" }
					}
				},
				{
					"comment": "Date and time in UTC",
					"match": "\\b(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{4})\\b",
					"captures": {
						"1": { "name": "comment.documentation" },
						"2": { "name": "keyword.other" }
					}
				},
				{
					"comment": "callsign and RST",
					"match": "\\b[A-Z0-9/]+\\s+(\\d{2,3})\\b",
					"captures": {
						"1": { "name": "keyword.control" },
						"2": { "name": "entity.operator" }
					}
				},
				{
					"comment": "Station number",
					"match": "\\b[01]\\b",
					"name": "constant.numeric"
				},
				{
					"comment": "exchange - multipliers",
					"match": "\\b[A-Z0-9]+\\b",
					"name": "string.unquoted"
				}
			]
		}
	],
	"repository": {}
}
